{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "port", "hosts", "runAsUser"],
  "properties": {
    "image": { "type": "string", "minLength": 1 },
    "port": { "type": "integer" },
    "hosts": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "runAsUser": { "type": "integer", "minimum": 1 },
    "imagePullSecret": { "type": "string" },
    "env": { "type": "object", "additionalProperties": { "type": "string" } },
    "envFromSecrets": { "type": "array", "items": { "type": "string" } },
    "writablePaths": { "type": "array", "items": { "type": "string" } },
    "resources": { "type": "object" },
    "persistence": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mountPath", "size"],
        "properties": {
          "mountPath": { "type": "string" },
          "size": { "type": "string" }
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "name": { "type": "string" },
        "owner": { "type": "string" },
        "size": { "type": "string" },
        "instances": { "type": "integer", "minimum": 1 },
        "envVar": { "type": "string" }
      },
      "if": { "properties": { "enabled": { "const": true } } },
      "then": {
        "properties": {
          "name": { "minLength": 1 },
          "owner": { "minLength": 1 }
        }
      }
    }
  }
}
