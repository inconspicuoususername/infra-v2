VERSION := $(shell mvn -q help:evaluate -Dexpression=project.version -DforceStdout)
RUNNER_IMAGE := registry.aquilla.dev/davud/borgmatic:2.0.13
CRDS_OUT := deploy/crds.yaml

.PHONY: test crds image runner-image

test:
	mvn -B test

# Regenerates deploy/crds.yaml from the Java types.
crds:
	mvn -B -q process-classes
	{ echo "# GENERATED by \`make crds\` from the Java types. Do not edit."; \
	  for f in target/classes/META-INF/fabric8/*.yml; do echo "---"; grep -v '^# Generated by Fabric8' $$f; done; } > $(CRDS_OUT)

# Pushes registry.aquilla.dev/davud/backup-operator:$(VERSION) and points
# deploy/ at it; bump <version> in pom.xml first.
image:
	mvn -B package jib:build
	cd deploy && kustomize edit set image registry.aquilla.dev/davud/backup-operator:$(VERSION)

runner-image:
	docker build -t $(RUNNER_IMAGE) runner
	docker push $(RUNNER_IMAGE)
